<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:id="@+id/rootContainer"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="?attr/android:colorBackground">

	<!-- Layer 1: ViewPager2 containing Fragments -->
	<androidx.viewpager2.widget.ViewPager2
		android:id="@+id/mainViewPager"
		android:layout_width="match_parent"
		android:layout_height="match_parent" />

	<!-- Layer 2: Bottom Scrim (Gradient Fade) -->
	<View
		android:id="@+id/bottomScrim"
		android:layout_width="match_parent"
		android:layout_height="110dp"
		android:layout_gravity="bottom"
		android:background="@drawable/bottom_scrim"
		android:clickable="false"
		android:focusable="false" />

	<!-- Layer 3: Floating Pill Navigation Bar -->
	<com.google.android.material.card.MaterialCardView
		android:id="@+id/floatingPillBar"
		android:layout_width="match_parent"
		android:layout_height="64dp"
		android:layout_gravity="bottom|center_horizontal"
		android:layout_marginBottom="20dp"
		android:layout_marginHorizontal="24dp"
		app:cardCornerRadius="32dp"
		app:cardElevation="6dp"
		app:strokeWidth="1dp"
		app:strokeColor="@color/md_theme_outlineVariant"
		app:cardBackgroundColor="@color/md_theme_surfaceContainerHigh">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:orientation="horizontal"
			android:gravity="center"
			android:paddingHorizontal="6dp"
			android:paddingVertical="4dp">

			<!-- Tab 1: Home -->
			<LinearLayout
				android:id="@+id/tabHome"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:gravity="center"
				android:orientation="vertical"
				android:clickable="true"
				android:focusable="true">

				<LinearLayout
					android:id="@+id/tabHomeIndicator"
					android:layout_width="wrap_content"
					android:layout_height="32dp"
					android:paddingHorizontal="16dp"
					android:gravity="center"
					android:background="@drawable/pill_tab_background">

					<ImageView
						android:id="@+id/tabHomeIcon"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:src="@drawable/ic_nav_home"
						app:tint="@color/md_theme_onSecondaryContainer"
						android:contentDescription="Trang chủ" />
				</LinearLayout>

				<TextView
					android:id="@+id/tabHomeText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Trang chủ"
					android:textSize="11sp"
					android:textColor="@color/md_theme_onSecondaryContainer"
					android:fontFamily="sans-serif-medium"
					android:layout_marginTop="2dp" />
			</LinearLayout>

			<!-- Tab 2: Mods -->
			<LinearLayout
				android:id="@+id/tabMods"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:gravity="center"
				android:orientation="vertical"
				android:clickable="true"
				android:focusable="true">

				<LinearLayout
					android:id="@+id/tabModsIndicator"
					android:layout_width="wrap_content"
					android:layout_height="32dp"
					android:paddingHorizontal="16dp"
					android:gravity="center">

					<ImageView
						android:id="@+id/tabModsIcon"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:src="@drawable/ic_nav_mods"
						app:tint="@color/md_theme_onSurfaceVariant"
						android:contentDescription="Mods" />
				</LinearLayout>

				<TextView
					android:id="@+id/tabModsText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Mods"
					android:textSize="11sp"
					android:textColor="@color/md_theme_onSurfaceVariant"
					android:fontFamily="sans-serif"
					android:layout_marginTop="2dp" />
			</LinearLayout>

			<!-- Tab 3: Tools -->
			<LinearLayout
				android:id="@+id/tabTools"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:gravity="center"
				android:orientation="vertical"
				android:clickable="true"
				android:focusable="true">

				<LinearLayout
					android:id="@+id/tabToolsIndicator"
					android:layout_width="wrap_content"
					android:layout_height="32dp"
					android:paddingHorizontal="16dp"
					android:gravity="center">

					<ImageView
						android:id="@+id/tabToolsIcon"
						android:layout_width="20dp"
						android:layout_height="20dp"
						android:src="@drawable/ic_nav_tools"
						app:tint="@color/md_theme_onSurfaceVariant"
						android:contentDescription="Công cụ" />
				</LinearLayout>

				<TextView
					android:id="@+id/tabToolsText"
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:text="Công cụ"
					android:textSize="11sp"
					android:textColor="@color/md_theme_onSurfaceVariant"
					android:fontFamily="sans-serif"
					android:layout_marginTop="2dp" />
			</LinearLayout>

		</LinearLayout>
	</com.google.android.material.card.MaterialCardView>

</FrameLayout>